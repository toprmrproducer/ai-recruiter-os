# AI Recruiter OS: copy this file to .env and fill in what you need.
#   cp .env.example .env
# Everything marked REQUIRED FOR CALLS can stay empty while you explore: the
# dashboard, careers page, CSV import and scoring all work without any keys.

# ---------------------------------------------------------------- app
PORT=4870
# Public address of this server. Dograh posts call results back to
# PUBLIC_BASE_URL/api/webhooks/dograh, so for real calls this must be reachable
# from the internet (your domain, or a Cloudflare / ngrok tunnel while testing).
PUBLIC_BASE_URL=http://localhost:4870
# Shown in the dashboard header and on screening calls.
BRAND_NAME=Recruit OS
# First name the voice agent introduces itself with on calls.
AGENT_NAME=Priya
# Dashboard password. Leave empty ONLY for local use. Set it before going online.
ADMIN_PASSWORD=
# Any long random string (openssl rand -hex 32). Signs the login cookie.
SESSION_SECRET=
# Optional shared secret Dograh sends as X-Webhook-Secret.
WEBHOOK_SECRET=
# Where the SQLite database lives. Default: recruiting.db next to server.js.
DB_PATH=
# Test fixtures only. For demo roles and sample leads use: npm run seed
SEED_DEMO_DATA=0

# ---------------------------------------------------------------- voice (Dograh) REQUIRED FOR CALLS
# Dograh is the open-source voice agent platform that places the calls.
# Quick start: https://github.com/dograh-hq/dograh  (one Docker command)
# Then run:  npm run setup:dograh   (creates the screening agent and prints the two values below)
DOGRAH_BASE_URL=http://localhost:8000
# API key: Dograh dashboard > Settings > API keys (starts with dgr_ or oss_).
DOGRAH_API_KEY=
# Printed by npm run setup:dograh. This is the agent's workflow UUID.
DOGRAH_AGENT_UUID=
# Numeric id of that agent in Dograh (printed by setup:dograh too). Needed for per-role voices: the app copies this agent for each voice.
DOGRAH_WORKFLOW_ID=1
# Same for the rejection call agent (optional).
DOGRAH_REJECTION_WORKFLOW_ID=
# Public address of your careers page, used for the role apply links in the dashboard (defaults to this server).
CAREERS_URL=
# Only needed for browser voice screens (optional).
DOGRAH_EMBED_TOKEN=
# Rejection call agent (printed by npm run setup:dograh). Lets a recruiter have the AI phone a rejected candidate.
DOGRAH_REJECTION_AGENT_UUID=
# Optional extra agents (reference checks, reminders). Same setup flow.
DOGRAH_REFERENCE_AGENT_UUID=
DOGRAH_REMINDER_AGENT_UUID=

# ---------------------------------------------------------------- calling safety lock
# The CSV call queue ONLY dials numbers listed here (comma separated, E.164 like +919876543210)
# or in call-allowlist.txt. Put your own number here to test safely.
IMPORT_CALL_ALLOWLIST=
# Production switch. Set to 1 only when every lead has consented to a call and you have
# checked do-not-call rules for your country. Until then the queue cannot ring strangers.
IMPORT_CALL_ANY=0

# ---------------------------------------------------------------- rejection emails (optional)
# Lets a recruiter send a personal rejection email from your own mailbox. Works with any SMTP
# provider (Hostinger, Google Workspace, Microsoft 365, Zoho, Mailgun...). Port 465 uses SSL/TLS,
# port 587 uses STARTTLS (set SMTP_SECURE=0 for 587).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER. Candidates who reply write to MAIL_REPLY_TO (or the From address).
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_REPLY_TO=
# Name the email is signed with. Defaults to MAIL_FROM_NAME.
MAIL_SIGNATURE_NAME=
# Safety lock, like the call lock: only these addresses (or @domains) can receive emails until you
# set MAIL_SEND_ANY=1. Put your own address here to test.
MAIL_ALLOWLIST=
MAIL_SEND_ANY=0

# ---------------------------------------------------------------- AI writing and analysis (all optional)
# Used for job drafting, resume analysis and message drafts. Without a key every feature
# falls back to built-in rules, so nothing breaks. Providers are tried left to right.
LLM_CHAIN=groq,zai,pollinations,custom,xai,anthropic
# Free tier: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Free flash model: https://z.ai
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-flash
# 1 allows the anonymous public Pollinations text API (no key).
POLLINATIONS_ENABLED=0
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=mistral
# Any OpenAI-compatible /chat/completions endpoint (Ollama, OpenRouter, LM Studio...).
LLM_CUSTOM_URL=
LLM_CUSTOM_KEY=
LLM_CUSTOM_MODEL=
XAI_API_KEY=
ANTHROPIC_API_KEY=
# Hard limit on real model calls per day, and a kill switch (1 = never call any model).
LLM_DAILY_CAP=400
LLM_DISABLE=0

# ---------------------------------------------------------------- NOT in this file (set inside Dograh)
# The voice itself runs in Dograh, so these live in the Dograh dashboard, not here:
#   Settings > Models   : your realtime voice model provider and key, and the agent voice
#   Settings > Telephony: your phone provider (for example Twilio account SID + auth token,
#                         or another provider Dograh supports) and the number calls come from
